# Biwenger Credentials
# Copy this file to .env and fill in your credentials
BIWENGER_EMAIL=your_email@example.com
BIWENGER_PASSWORD=your_password
BIWENGER_LEAGUE_ID=your_league_id
BIWENGER_USER_ID=your_user_id

# Optional: API version (default: 631)
# BIWENGER_VERSION=631

# Optional: Captain and striker field keys (discover with --probe)
# BIWENGER_CAPTAIN_KEY=captain
# BIWENGER_STRIKER_KEY=striker

# Optional: global wait budget (seconds) for retries/Rate-Limit
# BIWENGER_WAIT_BUDGET_SECONDS=90
# BIWENGER_UNKNOWN_STATE_PATH=/opt/data/unknown_state.json

# Optional: API version (default: 631)
# BIWENGER_VERSION=631

# Optional: Captain and striker field keys (discover with --probe)
# BIWENGER_CAPTAIN_KEY=captain
# BIWENGER_STRIKER_KEY=striker

# Optional: User agent and request tuning
# BIWENGER_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/154.0.0.0 Safari/537.36
# BIWENGER_REQUEST_TIMEOUT=30
# BIWENGER_MAX_RETRIES=1
# BIWENGER_RETRY_DELAY=30
# BIWENGER_REQUEST_DELAY=0.8
# BIWENGER_START_JITTER_MAX=0
# BIWENGER_RATE_LIMIT_WAIT_HOURS=4

# Optional: data directory (default: /opt/data)
# BIWENGER_DATA_DIR=/opt/data
# BIWENGER_MAX_LOG_ENTRIES=1500

# Optional: limits
# BIWENGER_MAX_WRITES=8
# BIWENGER_MAX_BUYS=2
# BIWENGER_MAX_SELLS=4
# BIWENGER_MIN_SQUAD=12
# BIWENGER_MAX_SQUAD=0
# BIWENGER_SELL_BENCH_LINEUP_READY=true

# Optional: scoring and strategy
# BIWENGER_MIN_LINEUP_GAIN=0.05
# BIWENGER_SELL_SCORE_MIN=2.0
# BIWENGER_MATCH_SOON_HOURS=48
# BIWENGER_MIN_P_START_BUY=0.7
# BIWENGER_CAPTAIN_MAX_VALUE=0
# BIWENGER_BUY_MARGIN=0.05
# BIWENGER_CUSHION_PCT=0.08
# BIWENGER_CUSHION_MIN=500000
# BIWENGER_BID_LOW=1.04
# BIWENGER_BID_MID=1.10
# BIWENGER_BID_HIGH=1.20
# BIWENGER_MAX_BID_PCT=1.25
# BIWENGER_BID_PLUS_ONE=true

# Optional: offers
# BIWENGER_ACCEPT_NORMAL=1.10
# BIWENGER_ACCEPT_HIGH=1.25
# BIWENGER_ACCEPT_INJURED=0.90
# BIWENGER_MAX_DROP_PCT=0.08
# BIWENGER_ACCEPT_MACHINE_MIN=0.92
# BIWENGER_MAX_TEAM_SIZE=16
